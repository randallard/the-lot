{
  "name": "townage",
  "private": true,
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "link:engine": "node scripts/link-engine.mjs",
    "dev": "node scripts/link-engine.mjs && vite",
    "build": "node scripts/link-engine.mjs && tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "node scripts/link-engine.mjs && vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "node scripts/link-engine.mjs && vitest --coverage --run",
    "postinstall": "node scripts/link-engine.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.8.2",
    "lz-string": "1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "square-one": "github:randallard/square-one#v0.11.0",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.9.0",
    "globals": "16.5.0",
    "happy-dom": "21.0.4",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
