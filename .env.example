# Copy to .env (or .env.local) and fill in. Never commit the filled copy; both are gitignored.

# Client-side (Vite exposes VITE_* to the browser, so nothing secret goes here).
VITE_INFERENCE_API_URL=
# Your Vercel deployment URL, to use the production chat API locally.
VITE_NPC_CHAT_URL=
VITE_SPACES_GAME_URL=
VITE_KINGS_COOKING_URL=

# Server-side only (the serverless proxy in api/; ADR-0006).
ANTHROPIC_API_KEY=
DISCORD_WEBHOOK=
